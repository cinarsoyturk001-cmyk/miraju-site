# Miraju OAuth + session configuration
# Copy this file to .env.local for local development or configure the same
# variables in your production hosting environment. Never commit real secrets.

NODE_ENV=development

# Frontend-visible Manus OAuth application settings
# The VITE_ prefix makes these values available in the browser bundle.
VITE_APP_ID=replace-with-manus-oauth-app-id
VITE_OAUTH_PORTAL_URL=https://replace-with-oauth-portal-host

# Server-side OAuth exchange endpoint
OAUTH_SERVER_URL=https://replace-with-oauth-server-host

# Session signing secret. Use a long random value (at least 32 bytes).
JWT_SECRET=replace-with-a-long-random-session-secret

# MySQL/TiDB connection used by Drizzle
DATABASE_URL=mysql://username:password@host:3306/miraju

# Owner account is promoted to admin when the OAuth openId matches.
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=Miraju Admin

# Optional Manus built-in services used by other features.
BUILT_IN_FORGE_API_URL=https://replace-with-forge-api-host
BUILT_IN_FORGE_API_KEY=replace-with-server-only-forge-key
